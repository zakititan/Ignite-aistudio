# OpenAI-powered Cornerstone Launch Assistant
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_FEATURE_ENABLED=false
AI_MAX_OUTPUT_TOKENS=500
AI_REQUEST_TIMEOUT_MS=20000
AI_SESSION_SECRET=

# Vercel KV / Upstash Redis for distributed rate limits
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional capacity controls
AI_PROJECT_DAILY_REQUEST_CAP=2000
AI_MAX_MESSAGE_CHARACTERS=2000
AI_MAX_CONTEXT_CHARACTERS=6000
